# Flask reads this locally. Render uses dashboard environment variables.
CHAIN_ID=11155111
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CONTRACT_ADDRESS=
DEPLOYMENT_BLOCK=
# Required only if deliberately running the local Hardhat network:
LOCAL_DEVELOPMENT=false
PORT=5000
RPC_TIMEOUT=10
LOG_CHUNK_SIZE=1000
HISTORY_PAGE_BLOCKS=5000

# Render: persistent PostgreSQL connection URL (keep credentials server-side).
# Local development: leave blank to use ignored instance/catalog.sqlite3.
DATABASE_URL=

# Optional command-line deployment only. NEVER configure a private key on Render.
# Alternatively deploy at /deploy with MetaMask; no key export is needed.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DEPLOYER_PRIVATE_KEY=
